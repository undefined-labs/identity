{
  "name": "@undefined-labs/identity",
  "version": "0.0.1",
  "description": "Identity, authentication, and authorization plugin for the OpenCore FiveM framework",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run clean && pnpm run build",
    "clean": "rimraf dist",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "test": "echo \"No tests yet\""
  },
  "keywords": [
    "opencore",
    "fivem",
    "framework",
    "identity",
    "authentication",
    "authorization",
    "permissions",
    "roles",
    "rbac"
  ],
  "author": "Undefined Labs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/undefined-labs/identity.git"
  },
  "homepage": "https://github.com/undefined-labs/identity#readme",
  "bugs": {
    "url": "https://github.com/undefined-labs/identity/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "@open-core/framework": "^0.3.2",
    "bcryptjs": "^3.0.3",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "uuid": "^13.0.0",
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "@open-core/framework": "^0.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "3.7.1",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "README.md"
  ]
}
